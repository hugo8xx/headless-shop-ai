<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_headless_api_user" model="res.groups">
            <field name="name">Headless API User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Read-only access for headless storefront integrations.</field>
        </record>

        <record id="group_headless_api_manager" model="res.groups">
            <field name="name">Headless API Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_headless_api_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
